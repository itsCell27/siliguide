-- SiliGuide Complete Database Schema
-- Single .sq file: src/main/sqldelight/com/example/siliguide/database/SiliGuide.sq

-- ============================================
-- IOT DEVICES TABLE
-- ============================================
CREATE TABLE iot_devices (
    device_id TEXT PRIMARY KEY,
    device_name TEXT NOT NULL,
    device_identifier TEXT NOT NULL,
    is_active INTEGER NOT NULL,
    last_known_ip TEXT,
    connection_mode TEXT NOT NULL
);

-- ============================================
-- PLANTS TABLE
-- ============================================
CREATE TABLE plants (
    plant_id TEXT PRIMARY KEY,
    plant_name TEXT NOT NULL,
    date_created INTEGER NOT NULL,
    last_analyzed_at INTEGER,
    device_id TEXT REFERENCES iot_devices(device_id) ON DELETE SET NULL
);

-- ============================================
-- ANALYSIS SESSIONS TABLE
-- ============================================
CREATE TABLE analysis_sessions (
    session_id TEXT PRIMARY KEY,
    plant_id TEXT NOT NULL REFERENCES plants(plant_id) ON DELETE CASCADE,
    device_id TEXT REFERENCES iot_devices(device_id) ON DELETE SET NULL,
    session_timestamp INTEGER NOT NULL,
    image_path TEXT,
    predicted_class TEXT NOT NULL,
    confidence REAL NOT NULL,
    air_temp REAL,
    light_intensity REAL,
    nitrogen INTEGER,
    phosphorus INTEGER,
    potassium INTEGER,
    electrical_conductivity INTEGER,
    soil_moisture REAL,
    soil_temp REAL,
    soil_ph REAL,
    plant_condition TEXT,
    possible_causes TEXT,
    symptoms TEXT,
    recommended_actions TEXT,
    is_partial INTEGER NOT NULL DEFAULT 0
);

-- ============================================
-- iot_devices queries

getDeviceById:
SELECT * FROM iot_devices WHERE device_id = ?;

getAllDevices:
SELECT * FROM iot_devices;

insertDevice:
INSERT INTO iot_devices (device_id, device_name, device_identifier, is_active, last_known_ip, connection_mode)
VALUES (?, ?, ?, ?, ?, ?);

updateDevice:
UPDATE iot_devices
SET device_name = ?, device_identifier = ?, is_active = ?, last_known_ip = ?, connection_mode = ?
WHERE device_id = ?;

deleteDevice:
DELETE FROM iot_devices WHERE device_id = ?;

getActiveDevices:
SELECT * FROM iot_devices WHERE is_active = 1;


-- ============================================
-- plant queries

getPlantById:
SELECT * FROM plants WHERE plant_id = ?;

getAllPlants:
SELECT * FROM plants;

getPlantsByDeviceId:
SELECT * FROM plants WHERE device_id = ?;

insertPlant:
INSERT INTO plants (plant_id, plant_name, date_created, last_analyzed_at, device_id)
VALUES (?, ?, ?, ?, ?);

updatePlant:
UPDATE plants
SET plant_name = ?, last_analyzed_at = ?, device_id = ?
WHERE plant_id = ?;

deletePlant:
DELETE FROM plants WHERE plant_id = ?;

updatePlantDevice:
UPDATE plants SET device_id = ? WHERE plant_id = ?;

unlinkPlantDevice:
UPDATE plants SET device_id = NULL WHERE plant_id = ?;

getUnlinkedPlants:
SELECT * FROM plants WHERE device_id IS NULL;


-- ============================================
-- analysis_sessions queries

getSessionById:
SELECT * FROM analysis_sessions WHERE session_id = ?;

getSessionsByPlantId:
SELECT * FROM analysis_sessions WHERE plant_id = ? ORDER BY session_timestamp DESC;

getSessionsByDeviceId:
SELECT * FROM analysis_sessions WHERE device_id = ? ORDER BY session_timestamp DESC;

getLatestSessionByPlantId:
SELECT * FROM analysis_sessions WHERE plant_id = ? ORDER BY session_timestamp DESC LIMIT 1;

getAllSessions:
SELECT * FROM analysis_sessions ORDER BY session_timestamp DESC;

insertSession:
INSERT INTO analysis_sessions (
    session_id, plant_id, device_id, session_timestamp, image_path, predicted_class, 
    confidence, air_temp, light_intensity, nitrogen, phosphorus, potassium, 
    electrical_conductivity, soil_moisture, soil_temp, soil_ph, plant_condition, 
    possible_causes, symptoms, recommended_actions, is_partial
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateSession:
UPDATE analysis_sessions
SET plant_condition = ?, possible_causes = ?, symptoms = ?, recommended_actions = ?
WHERE session_id = ?;

deleteSession:
DELETE FROM analysis_sessions WHERE session_id = ?;

getPartialDiagnosisSessions:
SELECT * FROM analysis_sessions WHERE is_partial = 1 AND plant_id = ? ORDER BY session_timestamp DESC;

getCompleteDiagnosisSessions:
SELECT * FROM analysis_sessions WHERE is_partial = 0 AND plant_id = ? ORDER BY session_timestamp DESC;

deleteOldSessions:
DELETE FROM analysis_sessions WHERE session_timestamp < ?;

-- ============================================
-- INDEXES FOR PERFORMANCE
-- ============================================
CREATE INDEX idx_plants_device_id ON plants(device_id);
CREATE INDEX idx_analysis_sessions_plant_id ON analysis_sessions(plant_id);
CREATE INDEX idx_analysis_sessions_device_id ON analysis_sessions(device_id);
CREATE INDEX idx_analysis_sessions_timestamp ON analysis_sessions(session_timestamp);
