-- ============================================================
-- SiliGuideDatabase.sq
-- Place this file at:
-- app/src/main/sqldelight/com/example/siliguide/data/local/SiliGuideDatabase.sq
-- ============================================================


-- ============================================================
-- TABLE: users
-- ============================================================

CREATE TABLE users (
    user_id       TEXT NOT NULL PRIMARY KEY,
    display_name  TEXT NOT NULL,
    email         TEXT,
    auth_provider TEXT NOT NULL, -- EMAIL | GOOGLE | GUEST
    is_guest      INTEGER NOT NULL DEFAULT 0
);

-- Queries: users

insertUser:
INSERT OR REPLACE INTO users (user_id, display_name, email, auth_provider, is_guest)
VALUES (?, ?, ?, ?, ?);

getUserById:
SELECT * FROM users WHERE user_id = ?;

deleteUser:
DELETE FROM users WHERE user_id = ?;

updateDisplayName:
UPDATE users SET display_name = ? WHERE user_id = ?;

updateEmail:
UPDATE users SET email = ? WHERE user_id = ?;


-- ============================================================
-- TABLE: iot_devices
-- ============================================================

CREATE TABLE iot_devices (
    device_id          TEXT NOT NULL PRIMARY KEY,
    user_id            TEXT NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
    device_name        TEXT NOT NULL,
    device_identifier  TEXT NOT NULL, -- MAC address or hardware ID
    is_active          INTEGER NOT NULL DEFAULT 1,
    last_known_ip      TEXT,          -- NULL if never connected via LAN
    connection_mode    TEXT NOT NULL, -- AP | LAN
    is_synced          INTEGER NOT NULL DEFAULT 0
);

-- Queries: iot_devices

insertDevice:
INSERT OR REPLACE INTO iot_devices (device_id, user_id, device_name, device_identifier, is_active, last_known_ip, connection_mode, is_synced)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getDevicesByUser:
SELECT * FROM iot_devices WHERE user_id = ? ORDER BY device_name ASC;

getDeviceById:
SELECT * FROM iot_devices WHERE device_id = ?;

updateDeviceName:
UPDATE iot_devices SET device_name = ? WHERE device_id = ?;

updateDeviceIp:
UPDATE iot_devices SET last_known_ip = ? WHERE device_id = ?;

updateDeviceActiveStatus:
UPDATE iot_devices SET is_active = ? WHERE device_id = ?;

markDeviceSynced:
UPDATE iot_devices SET is_synced = 1 WHERE device_id = ?;

getUnsyncedDevices:
SELECT * FROM iot_devices WHERE is_synced = 0;

deleteDevice:
DELETE FROM iot_devices WHERE device_id = ?;


-- ============================================================
-- TABLE: plants
-- ============================================================

CREATE TABLE plants (
    plant_id         TEXT NOT NULL PRIMARY KEY,
    user_id          TEXT NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
    plant_name       TEXT NOT NULL,
    date_created     TEXT NOT NULL,
    last_analyzed_at TEXT,           -- NULL until first analysis
    is_synced        INTEGER NOT NULL DEFAULT 0,
    device_id        TEXT REFERENCES iot_devices(device_id) ON DELETE SET NULL
);

-- Queries: plants

insertPlant:
INSERT OR REPLACE INTO plants (plant_id, user_id, plant_name, date_created, last_analyzed_at, is_synced, device_id)
VALUES (?, ?, ?, ?, ?, ?, ?);

getPlantsByUser:
SELECT * FROM plants WHERE user_id = ? ORDER BY date_created DESC;

getPlantById:
SELECT * FROM plants WHERE plant_id = ?;

updatePlantName:
UPDATE plants SET plant_name = ? WHERE plant_id = ?;

updatePlantDevice:
UPDATE plants SET device_id = ? WHERE plant_id = ?;

updateLastAnalyzedAt:
UPDATE plants SET last_analyzed_at = ? WHERE plant_id = ?;

markPlantSynced:
UPDATE plants SET is_synced = 1 WHERE plant_id = ?;

getUnsyncedPlants:
SELECT * FROM plants WHERE is_synced = 0;

deletePlant:
DELETE FROM plants WHERE plant_id = ?;


-- ============================================================
-- TABLE: analysis_sessions
-- ============================================================

CREATE TABLE analysis_sessions (
    session_id             TEXT NOT NULL PRIMARY KEY,
    plant_id               TEXT NOT NULL REFERENCES plants(plant_id) ON DELETE CASCADE,
    device_id              TEXT REFERENCES iot_devices(device_id) ON DELETE SET NULL,
    user_id                TEXT NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
    timestamp              TEXT NOT NULL,
    image_path             TEXT NOT NULL,
    predicted_class        TEXT NOT NULL, -- healthy | leaf_curling | leaf_spots | yellowing
    confidence             REAL NOT NULL, -- 0.0 to 1.0
    plant_condition        TEXT,          -- NULL for partial analysis
    possible_causes        TEXT NOT NULL, -- JSON array, always present
    symptoms               TEXT,          -- JSON array, NULL for partial
    recommended_actions    TEXT,          -- JSON array, NULL for partial
    is_partial             INTEGER NOT NULL DEFAULT 0, -- 1 = image only, no sensor data
    -- Sensor snapshot (all NULL for partial analysis)
    soil_moisture          REAL,
    soil_ph                REAL,
    soil_temp              REAL,
    electrical_conductivity INTEGER,
    nitrogen               INTEGER,
    phosphorus             INTEGER,
    potassium              INTEGER,
    light_intensity        INTEGER,
    air_temp               REAL,
    is_synced              INTEGER NOT NULL DEFAULT 0
);

-- Queries: analysis_sessions

insertSession:
INSERT OR REPLACE INTO analysis_sessions (
    session_id, plant_id, device_id, user_id, timestamp, image_path,
    predicted_class, confidence, plant_condition, possible_causes,
    symptoms, recommended_actions, is_partial,
    soil_moisture, soil_ph, soil_temp, electrical_conductivity,
    nitrogen, phosphorus, potassium, light_intensity, air_temp,
    is_synced
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getSessionsByPlant:
SELECT * FROM analysis_sessions WHERE plant_id = ? ORDER BY timestamp DESC;

getSessionsByUser:
SELECT * FROM analysis_sessions WHERE user_id = ? ORDER BY timestamp DESC;

getSessionById:
SELECT * FROM analysis_sessions WHERE session_id = ?;

getLatestSessionForPlant:
SELECT * FROM analysis_sessions WHERE plant_id = ? ORDER BY timestamp DESC LIMIT 1;

markSessionSynced:
UPDATE analysis_sessions SET is_synced = 1 WHERE session_id = ?;

getUnsyncedSessions:
SELECT * FROM analysis_sessions WHERE is_synced = 0;

deleteSession:
DELETE FROM analysis_sessions WHERE session_id = ?;

deleteSessionsByPlant:
DELETE FROM analysis_sessions WHERE plant_id = ?;
